{
  "name": "pos-offline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "bun run copy:wasm && nuxt generate",
    "build": "bun run generate",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run && node --test tests/scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run check:docs",
    "cap:sync": "bun run generate && cap sync android",
    "android:build": "bun run cap:sync && cd android && ./gradlew assembleDebug",
    "prepare:hooks": "git config core.hooksPath .githooks",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview --outDir .output/public --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@pinia/nuxt": "^0.11.0",
    "@vueuse/core": "^14.4.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jeep-sqlite": "2.8.0",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "ky": "^1.0.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.2.0",
    "pinia": "^3.0.0",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.10",
    "reka-ui": "^2.10.1",
    "sql.js": "1.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vue": "^3.5.40",
    "vue-router": "^5.4.0",
    "write-excel-file": "^2.0.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.3.8"
  },
  "patchedDependencies": {
    "jeep-sqlite@2.8.0": "patches/jeep-sqlite@2.8.0.patch"
  }
}
